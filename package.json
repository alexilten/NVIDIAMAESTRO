{
  "name": "nvidia-maestro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NVIDIA MAESTRO — hardware intelligence and spatial design platform: verified product catalog, exhibition kit of parts, Rhino ingest and export",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "export:samples": "vite-node scripts/export-samples.ts",
    "verify:3dm": "python3 scripts/verify_3dm.py samples/*.3dm",
    "fixtures": "vite-node scripts/fixture-files.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "earcut": "^3.0.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rhino3dm": "^8.35.0",
    "three": "^0.180.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-node": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
